{
  "name": "dsh-plugin-codex-mirror",
  "version": "1.1.1",
  "description": "Read-only live mirror of local Codex sessions inside DSH, with quote-to-draft, quote-to-new-session and a reviewed progress handoff file back to Codex.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.mjs",
    "client.js",
    "store.mjs",
    "handoff.mjs",
    "view.html",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "codex",
    "session",
    "mirror",
    "handoff"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddyfight/dsh-plugin-codex-mirror.git"
  },
  "homepage": "https://github.com/ddyfight/dsh-plugin-codex-mirror#readme",
  "bugs": {
    "url": "https://github.com/ddyfight/dsh-plugin-codex-mirror/issues"
  },
  "author": "ddyfight",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node --test-isolation=none --test store.test.mjs handoff.test.mjs",
    "verify": "node verify.mjs && node verify-new-session.mjs && node verify-progress.mjs && node verify-handoff-http.mjs"
  }
}
